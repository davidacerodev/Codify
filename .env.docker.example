# Configuración de Supabase que consume el contenedor; la clave de servicio es solo para servidor.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
# Server-side only. Required for administrator account creation; never expose
# this value through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
